# Backend Endoscopie (NestJS) — utilisé par le proxy Next.js (rewrites dans next.config.ts)
BACKEND_URL=http://127.0.0.1:3333

# Service Endoscopie (API CHU Railway)
NEXT_PUBLIC_ENDOSCOPIE_SERVICE_ID=
NEXT_PUBLIC_ENDOSCOPIE_CHU_ID=
NEXT_PUBLIC_CHU_API_URL=
NEXT_PUBLIC_ACCUEIL_API_URL=

# Service notifications
NEXT_PUBLIC_NOTIFICATION_API_URL=

# Service d'authentification centralisé (gateway + auth-service)
NEXT_PUBLIC_AUTH_GATEWAY_URL=
NEXT_PUBLIC_AUTH_ENDOSCOPIE_SERVICE_ID=

# Supabase (SUPABASE_SERVICE_ROLE_KEY est secrète — jamais côté client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
